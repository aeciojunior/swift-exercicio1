# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Supabase ──────────────────────────────────────────────────────────────────
# URL do projeto Supabase (Settings > API > Project URL)
SUPABASE_URL=https://<project-ref>.supabase.co

# Chave anon (Settings > API > Project API Keys > anon public)
SUPABASE_ANON_KEY=eyJ...

# Chave service_role (Settings > API > Project API Keys > service_role secret)
# ATENÇÃO: nunca expor no frontend — usar apenas no backend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Personal Access Token (para Management API, se necessário)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CoinGecko ─────────────────────────────────────────────────────────────────
# URL base da API (padrão: Demo/Free)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Chave da API CoinGecko (opcional para Demo tier, obrigatório para Pro)
# COINGECKO_API_KEY=CG-xxxxxxxxxxxxx

# Quantas moedas sincronizar no cron diário (default: 100)
COINGECKO_SYNC_TOP_N=100

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
